#!/usr/bin/env bash
# Start Jev Challenge Lab as a user service. Open the browser unless
# --service-only is requested by the Omarchy panel.
# The plugin sources stay read-only; state and the optional virtual environment
# live in the user's XDG data/state directories.
set -euo pipefail

plugin_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
data_dir="${XDG_DATA_HOME:-$HOME/.local/share}/jev-challenge-lab"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/jev-challenge-lab"
log_file="$state_dir/service.log"
url="http://127.0.0.1:8766"
system_python=/usr/bin/python3

mkdir -p "$data_dir" "$state_dir"
chmod 700 "$data_dir" "$state_dir"

notify_error() {
  notify-send --app-name="Jev Challenge Lab" "Jev Challenge Lab" "$1" 2>/dev/null || true
  printf '%s\n' "$1" >&2
}

is_our_service_running() {
  curl --fail --silent --max-time 1 "$url/api/health" >/dev/null 2>&1
}

if ! is_our_service_running; then
  if [ ! -x "$system_python" ]; then
    notify_error "Python 3 is required. Install python, then open the lab again."
    exit 1
  fi

  # A new lock or Python version gets a fresh environment, so packages from a
  # previous, unverified install cannot satisfy the dependency check.
  lock_hash=$(sha256sum "$plugin_dir/requirements.lock" | cut -d ' ' -f 1)
  python_version=$("$system_python" -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')
  venv_dir="$data_dir/venv-$python_version-${lock_hash:0:16}"
  ready_marker="$venv_dir/.jev-dependencies-installed"

  if [ ! -x "$venv_dir/bin/python" ]; then
    "$system_python" -m venv "$venv_dir"
  fi

  if [ ! -f "$ready_marker" ]; then
    "$venv_dir/bin/python" -m pip install --disable-pip-version-check --quiet \
      --require-hashes --only-binary=:all: -r "$plugin_dir/requirements.lock"
    touch "$ready_marker"
  fi

  JEV_SETTINGS_FILE="$state_dir/settings.json" \
  JEV_HISTORY_DB="$state_dir/history.db" \
  nohup "$venv_dir/bin/python" -m uvicorn backend.app:app \
    --app-dir "$plugin_dir" --host 127.0.0.1 --port 8766 --log-level warning \
    >>"$log_file" 2>&1 < /dev/null &

  ready=false
  for _ in $(seq 1 40); do
    if is_our_service_running; then
      ready=true
      break
    fi
    sleep 0.25
  done
  if [ "$ready" != true ]; then
    notify_error "The local service did not start. See $log_file for details."
    exit 1
  fi
fi

if [ "${1:-}" != "--service-only" ]; then
  xdg-open "$url/" >/dev/null 2>&1 &
fi
